# Copy to .env (git-ignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Spending guard-rails for the public demo
TRIAGE_MAX_DAILY_COST_USD=5.0
TRIAGE_MAX_PER_DAY=40
TRIAGE_MAX_PER_CLIENT_PER_HOUR=5
TRIAGE_MAX_CONCURRENT=2

# Token for POST /api/chaos/admin/clear-history (send it as the X-Admin-Token header).
# Leave empty on a public demo: the endpoint then returns 404. Generate one with: openssl rand -hex 24
TRIAGE_ADMIN_TOKEN=
